# ANNE V1 local configuration
# Copy to anne_config.env. Never commit anne_config.env.

ANNE_WEB_PROVIDER=openai

OPENAI_API_KEY=
ANNE_OPENAI_MODEL=gpt-4o-mini

XAI_API_KEY=
ANNE_XAI_MODEL=grok-2-latest

OPENROUTER_API_KEY=
GEMINI_API_KEY=

ANNE_MITOS_URL=
ANNE_CHATGPT_URL=

# External durable memory root (recommended on a dedicated drive)
# Examples: E:/ANNE   D:/ANNE   C:/Users/Public/ANNE
# If empty, ANNE uses a temporary project folder and warns.
ANNE_MEMORY_ROOT=

# Optional explicit DB path (defaults to %ANNE_MEMORY_ROOT%/memory/anne_memory.sqlite3)
ANNE_WEB_DB=

# Public upstream repository used for safe startup update checks.
ANNE_GITHUB_REPOSITORY=https://github.com/mgy421977-bit/anne-ai.git
ANNE_GITHUB_BRANCH=main
ANNE_AUTO_UPDATE=true

# Anonymous, content-free experience telemetry. OFF by default.
# When enabled, only aggregate cognitive event flags are queued locally.
# No question, answer, actor, evidence, memory, or API key is exported.
ANNE_SHARE_EXPERIENCE=false

ANNE_WEB_MAX_QUEUE=32
ANNE_WEB_PORT=8000
