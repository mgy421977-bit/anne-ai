# ANNE V1 local configuration
# Copy this file to anne_config.env and fill values.
# Never commit anne_config.env (it is gitignored).

# Language provider: openai | xai | openrouter | gemini
# Aliases: chatgpt -> openai, grok -> xai
ANNE_WEB_PROVIDER=openai

# ChatGPT / OpenAI
OPENAI_API_KEY=
ANNE_OPENAI_MODEL=gpt-4o-mini

# Grok / xAI
XAI_API_KEY=
ANNE_XAI_MODEL=grok-2-latest

# Optional alternatives
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# Optional ANNE-controlled research HTTP endpoints (not model tool-calls)
ANNE_MITOS_URL=
ANNE_CHATGPT_URL=

# Runtime
ANNE_WEB_DB=anne_data/anne_web.db
ANNE_WEB_MAX_QUEUE=32
ANNE_WEB_PORT=8000
